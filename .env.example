DISCORD_TOKEN=
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Optional (defaults shown)
# CACHE_DIR=./cache
# MAX_UPLOAD_MB=10
# MAX_CONCURRENT_RENDERS=1
# RENDER_TIMEOUT_SECONDS=600
# USER_COOLDOWN_SECONDS=60
# MAX_QUEUE_LENGTH=10
# DEV_GUILD_ID=
# FFMPEG_PATH=

# Song and background downloads. Mirrors are tried in order; each must be https:// and contain {set_id}
# BEATMAP_MIRRORS=https://osu.direct/api/d/{set_id}?noVideo=1,https://api.nerinyan.moe/d/{set_id}?nv=1
# MAX_SET_DOWNLOAD_MB=80
# CACHE_MAX_MB=500

# Background darkness, 0 (no dim) to 1 (black), during play and during intro, breaks and outro
# BACKGROUND_DIM_PLAY=0.7
# BACKGROUND_DIM_REST=0.4

# Folder containing an osu! skin's catch images (fruit-pear.png, fruit-catcher-idle.png, ...)
# SKIN_DIR=
